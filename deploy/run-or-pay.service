[Unit]
Description=Run or Pay challenge service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=runorpay
Group=runorpay
WorkingDirectory=/opt/run-or-pay
EnvironmentFile=/etc/run-or-pay/service.env
ExecStart=/usr/bin/node /opt/run-or-pay/src/server.js
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/run-or-pay

[Install]
WantedBy=multi-user.target
